# Tạo bằng lệnh: npx auth secret
AUTH_SECRET=42c09637975415888a483f99bcfa7c884137cd3c9ad99a5935b40c40a390ad22
AUTH_TRUST_HOST=true

# Google OAuth 2.0 Web application
AUTH_GOOGLE_ID=replace_with_google_client_id
AUTH_GOOGLE_SECRET=replace_with_google_client_secret
# Sign in with Apple for Web
AUTH_APPLE_ID=replace_with_apple_services_id
APPLE_TEAM_ID=replace_with_apple_team_id
APPLE_KEY_ID=replace_with_apple_key_id
# Dán toàn bộ file .p8 trên một dòng và thay xuống dòng bằng \n.
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_key_content\n-----END PRIVATE KEY-----"

PORT=3002
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional SMS webhook used by the password reset flow.
# The endpoint receives JSON: { phone, code, message }.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=